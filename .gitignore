# Local development byproducts — not part of the open-source release.
# (Root .gitignore already covers *.pth, logs/ and *output*/; the default
# paper checkpoint checkpoints/hyperfold_pocket_unisite_ds.pth is
# explicitly un-ignored there.)

# symlink into the parent checkout's datasets/ (users run scripts/download_data.sh)
/datasets

# benchmark prediction dumps and other run artifacts
/results/

# experiment checkpoints other than the released default model
/checkpoints/fold_hyperfold_deep_l21/

# example outputs — regenerated by scripts/predict.py and the panel renderer
/examples/_*
examples/*.prediction.pkl
examples/*.prediction.txt
# panels are kept tracked: the READMEs embed them
!examples/*_panel.png
